{
    "name": "actualizer/sulu-passkey",
    "description": "Passkey (WebAuthn) login for the Sulu admin, with management in the user profile.",
    "type": "sulu-bundle",
    "license": "MIT",
    "keywords": ["sulu", "sulu-bundle", "passkey", "webauthn", "fido2"],
    "require": {
        "php": "^8.4",
        "doctrine/doctrine-bundle": "^2.0 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.3 || ^4.0",
        "doctrine/orm": "^2.17.3 || ^3.3",
        "sulu/sulu": "^3.0.10",
        "symfony/clock": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/uid": "^7.4",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "cmsig/seal-memory-adapter": "^0.12",
        "doctrine/data-fixtures": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "scheb/2fa-bundle": "^7.4",
        "scheb/2fa-email": "^7.4",
        "scheb/2fa-trusted-device": "^7.4",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/monolog-bundle": "^3.10 || ^4.0",
        "symfony/yaml": "^7.4"
    },
    "suggest": {
        "scheb/2fa-bundle": "A passkey login skips the e-mail code of Sulu's two-factor login."
    },
    "autoload": {
        "psr-4": {"Actualizer\\SuluPasskey\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Actualizer\\SuluPasskey\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
